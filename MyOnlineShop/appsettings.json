{
  "ConnectionStrings": { "SqlServer": "" },
  "Database": { "CommandTimeoutSeconds": 30, "MaxRetryCount": 3 },
  "IdentitySecurity": {
    "Issuer": "MyOnlineShop",
    "Audience": "MyOnlineShop.Api",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "MaximumFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
